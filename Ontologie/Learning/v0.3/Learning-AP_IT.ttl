###  https://w3id.org/italia/onto/CLV/hasSpatialCoverage
<https://w3id.org/italia/onto/CLV/hasSpatialCoverage> rdf:type owl:ObjectProperty .


###  https://w3id.org/italia/onto/HER/hasAcademicDiscipline
<https://w3id.org/italia/onto/HER/hasAcademicDiscipline> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain :DegreeCourse ,
                                                                     :QualificationTitle ;
                                                         rdfs:range <https://w3id.org/italia/onto/HER/AcademicDiscipline> ;
                                                         rdfs:comment "Collega il titolo di qualifica alla disciplina accademica."@it ,
                                                                      "Links the qualification title to the academic discipline."@en ;
                                                         rdfs:label "ha disciplina accademica"@it ,
                                                                    "has academic discipline"@en .


###  https://w3id.org/italia/onto/Language/hasLanguage
<https://w3id.org/italia/onto/Language/hasLanguage> rdf:type owl:ObjectProperty .


###  https://w3id.org/italia/onto/Learning/atInstitute
:atInstitute rdf:type owl:ObjectProperty ;
             rdfs:domain :Enrolment ;
             rdfs:range :Institute ;
             rdfs:comment "Property used to link a person's enrolment in a specific (higher) education institution."@en ,
                          "Proprietà utilizzata per collegare l'iscrizione di una persona a uno specifico istituto di (alta) formazione."@it ;
             rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
             rdfs:label "a istituto di (alta) formazione"@it ,
                        "at institute"@en ;
             owl:versionInfo "stabile"@it ,
                             "stable"@en .


###  https://w3id.org/italia/onto/Learning/attends
:attends rdf:type owl:ObjectProperty ;
         rdfs:domain <https://w3id.org/italia/onto/CPV/Person> ;
         rdfs:range :Learning ;
         rdfs:comment "Property used to represent the attendance relationship of a person with respect to learning activities."@en ,
                      "Proprietà utilizzata per rappresentare la relazione di frequenza di una persona rispetto ad attività di apprendimento/insegnamento."@it ;
         rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
         rdfs:label "attends"@en ,
                    "frequenta"@it ;
         owl:versionInfo "stabile"@it ,
                         "stable"@en .


###  https://w3id.org/italia/onto/Learning/definesDegreeCourse
:definesDegreeCourse rdf:type owl:ObjectProperty ;
                     rdfs:domain :EducationalOffering ;
                     rdfs:range :DegreeCourse ;
                     rdfs:comment "Property that makes it possible to represent the degree courses that define the educational offerings of a (higher) education institution."@en ,
                                  "Proprietà che consente di rappresentare i corsi di laurea che definiscono l'offerta formativa di un istituto di (alta) formazione."@it ;
                     rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                     rdfs:label "defines degree course"@en ,
                                "definisce corso di laurea"@it ;
                     owl:versionInfo "stabile"@it ,
                                     "stable"@en .


###  https://w3id.org/italia/onto/Learning/definesProgrammeType
:definesProgrammeType rdf:type owl:ObjectProperty ;
                      rdfs:domain :EducationalOffering ;
                      rdfs:range :ProgrammeType ;
                      rdfs:comment "La proprietà utilizzata per rappresentare la tipologia di corso di studio nell'offerta formativa di un istituto di (alta) formazione."@it ,
                                   "The property used to represent the study programme type (e.g., Bachelor, PhD) in the educational offering of an institute."@en ;
                      rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                      rdfs:label "defines programme type"@en ,
                                 "definisce tipologia di corso di studi"@it ;
                      owl:versionInfo "stabile"@it ,
                                      "stable"@en .


###  https://w3id.org/italia/onto/Learning/enablesLearning
:enablesLearning rdf:type owl:ObjectProperty ;
                 rdfs:domain :Enrolment ;
                 rdfs:range :Learning ;
                 rdfs:comment "La proprietà che consente di rappresentare la relazione tra l'iscrizione che dà diritto alla partecipazione, da parte di una persona, a un percorso di insegnamenti."@it ,
                              "The property that makes it possible to represent the relationship between enrolment entitling a person to participate in a course of learning."@en ;
                 rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                 rdfs:label "abilita formazione"@it ,
                            "enables learning"@en ;
                 owl:versionInfo "stabile"@it ,
                                 "stable"@en .


###  https://w3id.org/italia/onto/Learning/enablesProfession
:enablesProfession rdf:type owl:ObjectProperty ;
                   rdfs:comment "Property that allows one to specify whether a qualification enables for one or more professions"@en ,
                                "Proprietà che consente di specificare qualora una qualifica abilit a una o più professioni"@it ;
                   rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                   rdfs:label "abilita professione"@it ,
                              "enables profession"@en ;
                   owl:versionInfo "provvisoria"@it ,
                                   "unstable"@en .


###  https://w3id.org/italia/onto/Learning/entitlesTo
:entitlesTo rdf:type owl:ObjectProperty ;
            rdfs:domain :LearningAchievementSpecification ;
            rdfs:range :Qualification ;
            rdfs:comment "Property that links the specification of all learning outcomes achieved in the learning followed by a person with the qualification that can be obtained through the achievement of the outcomes, according to the standards of the national education system."@en ,
                         "Proprietà che collega la specifica di tutti i risultati ottenuti negli insegnamenti seguiti da una persona con la qualifica che può essere ottenuta grazie al raggiungimento dei risultati, secondo standard del sistema educativo nazionale."@it ;
            rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
            rdfs:label "dà diritto a"@it ,
                       "entitles to"@en ;
            owl:versionInfo "provvisoria"@it ,
                            "unstable"@en .


###  https://w3id.org/italia/onto/Learning/hasAcademicYear
:hasAcademicYear rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <https://w3id.org/italia/onto/TI/hasTemporalEntity> ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :EducationalOffering
                                             :Enrolment
                                           )
                             ] ;
                 rdfs:range :AcademicYear ;
                 rdfs:comment "General property used to specify an academic year for the enrolment and the educational offering."@en ,
                              "Proprietà generale utilizzata per specificare un anno accademico per l'iscrizione e l'offerta formativa."@it ;
                 rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                 rdfs:label "ha anno accademico"@it ,
                            "has academic year"@en ;
                 owl:versionInfo "stabile"@it ,
                                 "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasAchievedTitle
:hasAchievedTitle rdf:type owl:ObjectProperty ;
                  rdfs:domain :Enrolment ;
                  rdfs:range :Qualification ;
                  rdfs:comment "La proprietà che consente di rappresentare che una certa iscrizione di una persona a un istituto di (alta) formazione ha portato al conseguimento di un titolo (qualifica)."@it ,
                               "The property that makes it possible to represent that a certain enrolment of a person at an institution of (higher) education has led to the attainment of a title (qualification)."@en ;
                  rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                  rdfs:label "ha titolo ottenuto"@it ,
                             "has achieved title"@en ;
                  owl:versionInfo "stabile"@it ,
                                  "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasDegreeClass
:hasDegreeClass rdf:type owl:ObjectProperty ;
                owl:inverseOf :isDegreeClassOf ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :DegreeCourse
                                            :Enrolment
                                          )
                            ] ;
                rdfs:range :DegreeClass ;
                rdfs:comment "The property used to specify the degree classes both in enrolments and in the relationship with degree courses."@en ,
                             "La proprietà utilizzata per specificare le classi di laurea sia nelle iscrizioni sia nel rapporto con i corsi di laurea." ;
                rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                rdfs:label "ha classe di laurea"@it ,
                           "has degree class"@en ;
                owl:versionInfo "stabile"@it ,
                                "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasDegreeCourse
:hasDegreeCourse rdf:type owl:ObjectProperty ;
                 rdfs:domain :Enrolment ;
                 rdfs:range :DegreeCourse ;
                 rdfs:comment "La proprietà consente di rappresentare il corso di laurea che una persona sceglie quando si iscrive a un istituto di (alta) formazione."@it ,
                              "The property makes it possible to represent the degree course a person chooses when enrolling in an institution of (higher) education."@en ;
                 rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                 rdfs:label "ha corso di laurea"@it ,
                            "has degree course"@en ;
                 owl:versionInfo "stabile"@it ,
                                 "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasEOSite
:hasEOSite rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf <https://w3id.org/italia/onto/CLV/hasSpatialCoverage> ;
           rdfs:domain :EducationalOffering ;
           rdfs:range :EducationalOfferingSite ;
           rdfs:comment "Property used to represent the location of the (higher) education institution in its educational offering."@en ,
                        "Proprietà usata per rappresentare la sede dell'istituto di (alta) formazione nell'offerta formativa dello stesso."@it ;
           rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
           rdfs:label "ha sede offerta formativa"@it ,
                      "has educational offering site"@en ;
           owl:versionInfo "stabile"@it ,
                           "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasEducationalOffering
:hasEducationalOffering rdf:type owl:ObjectProperty ;
                        rdfs:domain :Institute ;
                        rdfs:range :EducationalOffering ;
                        rdfs:comment "La proprietà che consente di specificare l'offerta formativa di un istituto di (alta) formazione."@it ,
                                     "The property that allows one to specify the educational offering of a (higher) education institution."@en ;
                        rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                        rdfs:label "ha offerta formativa"@it ,
                                   "has educational offering"@en ;
                        owl:versionInfo "stabile"@it ,
                                        "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasEnrolment
:hasEnrolment rdf:type owl:ObjectProperty ;
              owl:inverseOf :isEnrolmentOf ;
              rdfs:domain <https://w3id.org/italia/onto/CPV/Person> ;
              rdfs:range :Enrolment ;
              rdfs:comment "Property that allows one to represent enrolment in a (higher) education institution for a person."@en ,
                           "Proprietà che consente di rappresentare l'iscrizione a un istituto di (alta) formazione per una persona."@it ;
              rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
              rdfs:label "ha iscrizione"@it ,
                         "has enrolment"@en ;
              owl:versionInfo "stabile"@it ,
                              "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasEnrolmentStatus
:hasEnrolmentStatus rdf:type owl:ObjectProperty ;
                    rdfs:domain :Enrolment ;
                    rdfs:range :EnrolmentStatus ;
                    rdfs:comment "Property that allows an enrolment to be linked to its status (open, terminated, suspended)."@en ,
                                 "Proprietà che consente di collegare l'iscrizione a un suo stato (aperta, terminata, sospesa)."@it ;
                    rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                    rdfs:label "ha stato iscrizione"@it ,
                               "has enrolment status"@en ;
                    owl:versionInfo "stabile"@it ,
                                    "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasEnrolmentValidity
:hasEnrolmentValidity rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <https://w3id.org/italia/onto/TI/hasTemporalEntity> ;
                      rdfs:domain :Enrolment ;
                      rdfs:range <https://w3id.org/italia/onto/TI/TemporalEntity> ;
                      rdfs:comment "La proprietà che consente di specificare la validità di un'iscrizione in termini temporali."@it ,
                                   "The property that allows one to indicate the validity of an enrolment to be specified in terms of time."@en ;
                      rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                      rdfs:label "ha periodo di validà iscrizione"@it ,
                                 "has enrolment validity period"@en ;
                      owl:versionInfo "stabile"@it ,
                                      "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasGrade
:hasGrade rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Examination
                                      :Qualification
                                    )
                      ] ;
          rdfs:range :Grade ;
          rdfs:comment "Property allowing a grade to be specified in the  qualification obtained or in each examination taken."@en ,
                       "Proprietà che consente di specificare un voto nella qualifica finale ottenuto o in ciascun esame sostenuto."@it ;
          rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
          rdfs:label "ha voto"@it ,
                     "has grade"@en ;
          owl:versionInfo "stabile"@it ,
                          "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasGradingScale
:hasGradingScale rdf:type owl:ObjectProperty ;
                 rdfs:domain :Grade ;
                 rdfs:range :GradingScale ;
                 rdfs:comment "Property that allows a grade scale to be defined in the grade specification."@en ,
                              "Proprietà che consente di definire una scala di voti nella specifica del voto."@it ;
                 rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                 rdfs:label "ha scala di valutazione"@it ,
                            "has grading scale"@en ;
                 owl:versionInfo "stabile"@it ,
                                 "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasInstituteType
:hasInstituteType rdf:type owl:ObjectProperty ;
                  rdfs:domain :Institute ;
                  rdfs:range :InstituteType ;
                  rdfs:comment "Property used to specify the type of (higher) education institution."@en ,
                               "Proprietà utilizzata per specificare la tipologia di istituto di (alta) formazione."@it ;
                  rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                  rdfs:label "ha tipo istituto"@it ,
                             "has institute type"@en ;
                  owl:versionInfo "stabile"@it ,
                                  "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasLastEnrolmentYear
:hasLastEnrolmentYear rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :Enrolment ;
                      rdfs:range :AcademicYear ;
                      rdfs:comment "Property used to indicate the last academic year in which the student was enrolled in the degree course."@en ,
                                   "Proprietà utilizzata per indicare nell'iscrizione l'ultimo anno accademico in cui lo studente risulta iscritto al corso."@it ;
                      rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                      rdfs:label "ha ultimo anno accademico iscrizione corso"@it ,
                                 "has last enrolment year"@en ;
                      owl:versionInfo "stabile"@it ,
                                      "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasLevel
:hasLevel rdf:type owl:ObjectProperty ;
          rdfs:comment "Property allowing the qualification level to be specified according to the European Qualification Framework standards and its mapping to the national one."@it ,
                       "Proprietà che consente di specificare il livello della qualifica secondo gli standard dell'European Qualification Framework e relativi mapping su quello nazionale."@it ;
          rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
          rdfs:label "ha livello"@it ,
                     "has level"@en ;
          owl:versionInfo "provvisoria"@it ,
                          "unstable"@en .


###  https://w3id.org/italia/onto/Learning/hasMaximumGrade
:hasMaximumGrade rdf:type owl:ObjectProperty ;
                 rdfs:domain :GradingScale ;
                 rdfs:range :Grade ;
                 rdfs:comment "Property that allows one to specify the maximum grade on the grading scale."@en ,
                              "Proprietà che consente di specificare il voto massimo nella scala di valutazione."@it ;
                 rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                 rdfs:label "ha voto massimo"@it ,
                            "has maximum grade"@en ;
                 owl:versionInfo "stabile"@it ,
                                 "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasMinimumGrade
:hasMinimumGrade rdf:type owl:ObjectProperty ;
                 rdfs:domain :GradingScale ;
                 rdfs:range :Grade ;
                 rdfs:comment "Property that allows one to specify the minimum grade on the grading scale."@en ,
                              "Proprietà che consente di specificare il voto minimo nella scala di valutazione."@it ;
                 rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                 rdfs:label "ha voto minimo"@it ,
                            "has minimum grade"@en ;
                 owl:versionInfo "stabile"@it ,
                                 "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasProgrammeType
:hasProgrammeType rdf:type owl:ObjectProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :DegreeClass
                                              :Enrolment
                                            )
                              ] ;
                  rdfs:range :ProgrammeType ;
                  rdfs:comment "Property used to specify the type of study programme. It is currently valued for enrolment and for linking degree classes to the relevant programme type."@en ,
                               "Proprietà usata per specificare la tipologia di corso di studi. È attualmente valorizzata per l'iscrizione e per collegare le classi di laurea alla relativa tipologia di corsi di studi."@it ;
                  rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                  rdfs:label "ha tipologia di corso di studi"@it ,
                             "has programme type"@en ;
                  owl:versionInfo "stabile"@it ,
                                  "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasQualificationTitle
:hasQualificationTitle rdf:type owl:ObjectProperty ;
                       rdfs:domain :Qualification ;
                       rdfs:range :QualificationTitle ;
                       rdfs:comment "Collega una qualifica al titolo ufficiale con cui essa è denominata nel sistema formativo."@it ,
                                    "Links a qualification to the official title under which it is designated in the education system."@en ;
                       rdfs:label "ha titolo di qualifica"@it ,
                                  "has qualification title"@en .


###  https://w3id.org/italia/onto/Learning/hasRegistrationYear
:hasRegistrationYear rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <https://w3id.org/italia/onto/TI/hasTemporalEntity> ;
                     rdfs:domain :Enrolment ;
                     rdfs:range :AcademicYear ;
                     rdfs:comment "Property that allows you to specify the academic year of a person's registration (i.e., the academic year in which the student was admitted to the (higher) education institution, the specified course of study)."@en ,
                                  "Proprietà che consente di specifica l'anno accademico di immatricolazione di una persona (i.e.,l'anno accademico nel quale lo studente ha avuto accesso all'istituto di (alta) formazione, al corso di studi specificato)."@it ;
                     rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                     rdfs:label "ha anno accademico di immatricolazione"@it ,
                                "has registration year"@en ;
                     owl:versionInfo "stabile"@it ,
                                     "stable"@en .


###  https://w3id.org/italia/onto/Learning/hasTitleArea
:hasTitleArea rdf:type owl:ObjectProperty ;
              rdfs:domain :QualificationTitle ;
              rdfs:range :TitleArea ;
              rdfs:comment "Collega un titolo accademico alla relativa area di classificazione del titolo."@it ,
                           "Links an academic title to its corresponding title classification area."@en ;
              rdfs:label "ha area del titolo"@it ,
                         "has title area"@en .


###  https://w3id.org/italia/onto/Learning/includesExamination
:includesExamination rdf:type owl:ObjectProperty ;
                     rdfs:domain :Learning ;
                     rdfs:range :Examination ;
                     rdfs:comment "Property that links a learning activity with its associated examinations."@en ,
                                  "Proprietà che collega un insegnamento con gli esami ad esso associati."@it ;
                     rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                     rdfs:label "include esame"@it ,
                                "includes examination"@en ;
                     owl:versionInfo "stabile"@it ,
                                     "stable"@en .


###  https://w3id.org/italia/onto/Learning/isDegreeClassOf
:isDegreeClassOf rdf:type owl:ObjectProperty ;
                 rdfs:domain :DegreeClass ;
                 rdfs:range [ rdf:type owl:Class ;
                              owl:unionOf ( :DegreeCourse
                                            :Enrolment
                                          )
                            ] ;
                 rdfs:comment "Inverse property of 'has degree class' that allows the degree class to be linked to the enrolment and degree courses to which they relate."@en ,
                              "Proprietà inversa di 'ha classe di laurea' che consente di collegare la classe di laurea all'iscrizione e ai corso di laurea a cui si riferiscono."@it ;
                 rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                 rdfs:label "is degree class of"@en ,
                            "è classe di laurea di"@it ;
                 owl:versionInfo "stabile"@it ,
                                 "stable"@en .


###  https://w3id.org/italia/onto/Learning/isEnrolmentOf
:isEnrolmentOf rdf:type owl:ObjectProperty ;
               rdfs:domain :Enrolment ;
               rdfs:range <https://w3id.org/italia/onto/CPV/Person> ;
               rdfs:comment "Inverse property of 'has enrolment' which allows enrolments to be associated with the relevant persons."@en ,
                            "Proprietà inversa di 'has enrolment' che consente di associare le iscrizioni alle relative persone."@it ;
               rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
               rdfs:label "is enrolment of"@en ,
                          "è iscrizione di persona"@it ;
               owl:versionInfo "stabile"@it ,
                               "stable"@en .


###  https://w3id.org/italia/onto/Learning/issuedBy
:issuedBy rdf:type owl:ObjectProperty ;
          rdfs:domain :Qualification ;
          rdfs:range :Institute ;
          rdfs:comment "Property that links the qualification to the (higher) education institution that awarded it."@en ,
                       "Proprietà che lega la qualifica all'istituto di (alta) formazione che l'ha rilasciata."@it ;
          rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
          rdfs:label "issued by"@en ,
                     "rilasciata da"@it ;
          owl:versionInfo "stabile"@it ,
                          "stable"@en .


###  https://w3id.org/italia/onto/Learning/leadsTo
:leadsTo rdf:type owl:ObjectProperty ;
         rdfs:domain :FinalExamination ;
         rdfs:range :Qualification ;
         rdfs:comment "Property that links the final examination of a course of learning, where a (degree) thesis may be discussed and presented, to the qualification/title."@en ,
                      "Proprietà che lega l'esame finale di un percorso di studi, dove può venire discussa e presentata una tesi (di laurea), alla qualifica/titolo."@it ;
         rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
         rdfs:label "conduce a"@it ,
                    "leads to"@en ;
         owl:versionInfo "stabile"@it ,
                         "stable"@en .


###  https://w3id.org/italia/onto/Learning/providedBy
:providedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Learning ;
            rdfs:range :Institute ;
            rdfs:comment "Property that links the learning to the institution that delivers it."@en ,
                         "Proprietà che consente di rappresentare il collegamento tra l'insegnamento e l'istituto che lo eroga."@it ;
            rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
            rdfs:label "erogato da"@it ,
                       "provided by"@en ;
            owl:versionInfo "stabile"@it ,
                            "stable"@en .


