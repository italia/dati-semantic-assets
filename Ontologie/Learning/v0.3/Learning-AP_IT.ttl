###  http://dati.gov.it/onto/dcatapit#Agent
<http://dati.gov.it/onto/dcatapit#Agent> rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Agent
foaf:Agent rdf:type owl:Class .


###  https://w3id.org/italia/onto/ADMS/Project
admsapit:Project rdf:type owl:Class .


###  https://w3id.org/italia/onto/ADMS/SemanticAsset
admsapit:SemanticAsset rdf:type owl:Class .


###  https://w3id.org/italia/onto/ADMS/SemanticAssetDistribution
admsapit:SemanticAssetDistribution rdf:type owl:Class .


###  https://w3id.org/italia/onto/CLV/Feature
<https://w3id.org/italia/onto/CLV/Feature> rdf:type owl:Class .


###  https://w3id.org/italia/onto/CPV/Person
<https://w3id.org/italia/onto/CPV/Person> rdf:type owl:Class .


###  https://w3id.org/italia/onto/HER/AcademicDiscipline
<https://w3id.org/italia/onto/HER/AcademicDiscipline> rdf:type owl:Class .


###  https://w3id.org/italia/onto/Language/Language
<https://w3id.org/italia/onto/Language/Language> rdf:type owl:Class .


###  https://w3id.org/italia/onto/Learning/AcademicTitle
:AcademicTitle rdf:type owl:Class ;
               rdfs:subClassOf :QualificationTitle ;
               rdfs:comment "It is a type of qualification title obtained upon completion of a standard academic programme within university or AFAM systems. It includes titles that award official academic degrees recognized at national and European level."@en ,
                            "È un tipo di titolo della qualifica che deriva dal completamento di un percorso accademico ordinario previsto dagli ordinamenti universitari o AFAM. Comprende titoli che attribuiscono gradi accademici riconosciuti a livello nazionale ed europeo."@it ;
               rdfs:label "Academic Title"@en ,
                          "Titolo Accademico"@it .


###  https://w3id.org/italia/onto/Learning/AcademicYear
:AcademicYear rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/italia/onto/TI/Duration> ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :academicYear ;
                                owl:cardinality "1"^^xsd:nonNegativeInteger
                              ] ;
              rdfs:comment "A time frame (duration) for the training of students in an academic environment. Example: 2022/2023"@en ,
                           "Una durata temporale in cui si svolgono attività di formazione di studenti in ambito accademico. Esempio: 2022/2023"@it ;
              rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
              rdfs:label "Academic Year"@en ,
                         "Anno Accademico"@it ;
              owl:versionInfo "stabile"@it ,
                              "stable"@en .


###  https://w3id.org/italia/onto/Learning/DegreeClass
:DegreeClass rdf:type owl:Class ;
             rdfs:subClassOf l0:Concept ,
                             l0:Topic ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isDegreeClassOf ;
                               owl:someValuesFrom :DegreeCourse
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isDegreeClassOf ;
                               owl:allValuesFrom :DegreeCourse
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasProgrammeType ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :ProgrammeType
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty l0:identifier ;
                               owl:someValuesFrom rdfs:Literal
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty l0:name ;
                               owl:someValuesFrom rdfs:Literal
                             ] ;
             rdfs:comment "Le istanze di questa classe sono i concetti di un vocabolario controllato sulle classi di laurea (e.g., 06/S - Specialistiche in biologia, 05 - Lettere, ecc.). La classe di laurea è identificata da un codice univoco e da una denominazione (nome). Una classe di laurea è associata a uno o più corsi di laurea e a uno e un solo programma di studi."@it ,
                          "The instances of this class are the concepts of a controlled vocabulary of degree classes (e.g., 06/S - Specialisation in Biology, 05 - Humanities, etc.). The degree class is identified by a unique code and a designation (name). A degree class is associated with one or more degree courses and one and only one study programme."@en ;
             rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
             rdfs:label "Classe di Laurea"@it ,
                        "Degree Class"@en ;
             owl:versionInfo "stabile"@it ,
                             "stable"@en ;
             <http://www.w3.org/ns/prov#wasDerivedFrom> <http://www.w3.org/2004/02/skos/core#Concept> .


###  https://w3id.org/italia/onto/Learning/DegreeCourse
:DegreeCourse rdf:type owl:Class ;
              rdfs:subClassOf l0:Collection ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasDegreeClass ;
                                owl:someValuesFrom :DegreeClass
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty <https://w3id.org/italia/onto/HER/hasAcademicDiscipline> ;
                                owl:allValuesFrom <https://w3id.org/italia/onto/HER/AcademicDiscipline>
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty <https://w3id.org/italia/onto/Language/hasLanguage> ;
                                owl:allValuesFrom <https://w3id.org/italia/onto/Language/Language>
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasDegreeClass ;
                                owl:allValuesFrom :DegreeClass
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty l0:hasMember ;
                                owl:allValuesFrom :Learning
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty l0:name ;
                                owl:someValuesFrom rdfs:Literal
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :credit ;
                                owl:cardinality "1"^^xsd:nonNegativeInteger
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty l0:identifier ;
                                owl:cardinality "1"^^xsd:nonNegativeInteger
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty <https://w3id.org/italia/onto/SM/URL> ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:anyURI
                              ] ;
              rdfs:comment "The degree course chosen by the student. Its aim is to ensure that the student has an adequate knowledge of general scientific methods and content, even if it is oriented towards the acquisition of specific professional knowledge. (e.g. degree course in computer science, degree course in literature, etc.)."@en ,
                           "Il percorso di studi scelto dallo studente. Ha l'obiettivo di assicurare allo studente un'adeguata padronanza di metodi e contenuti scientifici generali, anche nel caso in cui sia orientato all'acquisizione di specifiche conoscenze professionali. (e.g., corso di laurea in informatica, corso di laurea in lettere, ecc.)." ;
              rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
              rdfs:label "Corso di Laurea"@it ,
                         "Degree Course"@en ;
              owl:versionInfo "stabile"@it ,
                              "stable"@en ;
              <http://www.w3.org/ns/prov#wasDerivedFrom> <http://www.w3.org/2004/02/skos/core#Concept> .


###  https://w3id.org/italia/onto/Learning/EducationalOffering
:EducationalOffering rdf:type owl:Class ;
                     rdfs:subClassOf l0:Description ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <https://w3id.org/italia/onto/Language/hasLanguage> ;
                                       owl:someValuesFrom <https://w3id.org/italia/onto/Language/Language>
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :definesDegreeCourse ;
                                       owl:someValuesFrom :DegreeCourse
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :definesProgrammeType ;
                                       owl:someValuesFrom :ProgrammeType
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasEOSite ;
                                       owl:someValuesFrom :EducationalOfferingSite
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <https://w3id.org/italia/onto/Language/hasLanguage> ;
                                       owl:allValuesFrom <https://w3id.org/italia/onto/Language/Language>
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :definesDegreeCourse ;
                                       owl:allValuesFrom :DegreeCourse
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :definesProgrammeType ;
                                       owl:allValuesFrom :ProgrammeType
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasEOSite ;
                                       owl:allValuesFrom :EducationalOfferingSite
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasAcademicYear ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :AcademicYear
                                     ] ;
                     rdfs:comment """It represents the set of degree courses offered by institutes in Italy.

The educational offering is described by several elements. In the current version of the ontology, the educational offering is described by the academic year, the location of the institution, the programme type, the degree courses and the language of delivery."""@en ,
                                  """Rappresenta l’insieme dei corsi di studio che gli Istituti propongono sul territorio italiano.

L'offerta formativa viene descritta da diversi elementi. Nell'attuale versione dell'ontologia, l'offerta formativa è descritta dall'anno accademico, dalla sede dell'istituto, dalla tipologia di corso di studi, dai corsi di laurea e dalla lingua di erogazione."""@it ;
                     rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                     rdfs:label "Educational Offering"@en ,
                                "Offerta formativa"@it ;
                     owl:versionInfo "provvisoria"@it ,
                                     "unstable"@en .


###  https://w3id.org/italia/onto/Learning/EducationalOfferingSite
:EducationalOfferingSite rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/italia/onto/CLV/Feature> ;
                         rdfs:comment "Il luogo o sede dell'istituto di (alta) formazione di erogazione di una specifica offerta formativa."@it ,
                                      "The location or site of the (higher) education institution providing a specific educational offering."@en ;
                         rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                         rdfs:label "Educational Offering Site"@en ,
                                    "Luogo Offerta Formativa"@it ;
                         owl:versionInfo "stabile"@it ,
                                         "stable"@en .


###  https://w3id.org/italia/onto/Learning/Enrolment
:Enrolment rdf:type owl:Class ;
           rdfs:subClassOf l0:EventOrSituation ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :atInstitute ;
                             owl:someValuesFrom :Institute
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :atInstitute ;
                             owl:allValuesFrom :Institute
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasDegreeCourse ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :DegreeCourse
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasProgrammeType ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :ProgrammeType
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasEnrolmentStatus ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :EnrolmentStatus
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasRegistrationYear ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :AcademicYear
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :courseYear ;
                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                           ] ;
           rdfs:comment """A situation in which a person formally registers with a (higher) education institution becoming a student.

From a technical point of view, the enrolment class represents an n-ary that brings together several elements: academic year, a specific type of programme type (e.g. bachelor's degree, master's degree, etc.), a specific degree class and a specific degree course (e.g. Computer Engineering, Political Science, etc.).

The enrolment has a temporal validity."""@en ,
                        """Una situazione che vede una persona registrarsi formalmente presso un istituto di istruzione (superiore) assumendo così il ruolo di studente.

Da un punto di vista tecnico, la classe iscrizione rappresenta una n-ary che mette insieme diversi elementi: anno accademico, uno specifico tipo di corso di studi (e.g., laurea triennale, laurea magistrale, ecc.), una specifica classe di laurea e uno specifico corso di laurea (e.g., Ingegneria Informatica, Scienze Politiche, ecc.).

L'iscrizione ha una validità temporale."""@it ;
           rdfs:isDefinedBy "https://w3id.org/italia/onto/Learning" ;
           rdfs:label "Enrolment"@en ,
                      "Iscrizione"@it ;
           owl:versionInfo "stabile"@it ,
                           "stable"@en .


###  https://w3id.org/italia/onto/Learning/EnrolmentStatus
:EnrolmentStatus rdf:type owl:Class ;
                 rdfs:subClassOf l0:Characteristic ;
                 rdfs:comment "La classe che determina in che stato si trova l'iscrizione. Essa può essere infatti attiva, sospesa o terminata."@it ,
                              "The class determines what status the enrolment is in. It can in fact be active, suspended and terminated."@en ;
                 rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                 rdfs:label "Enrolment Status"@en ,
                            "Stato Iscrizione"@it ;
                 owl:versionInfo "stabile"@it ,
                                 "stable"@en .


###  https://w3id.org/italia/onto/Learning/Examination
:Examination rdf:type owl:Class ;
             rdfs:subClassOf <https://w3id.org/italia/onto/TI/TimeIndexedEvent> ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasGrade ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Grade
                             ] ;
             rdfs:comment "A formal test of a person's knowledge or proficiency to be taken at a specific time in a specific subject or skill."@en ,
                          "Una prova formale di conoscenza o di abilità di una persona da sostenere in un momento specifico in una determinata materia."@it ;
             rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
             rdfs:label "Esame"@it ,
                        "Examination"@en ;
             owl:versionInfo "stabile"@it ,
                             "stable"@en .


###  https://w3id.org/italia/onto/Learning/FinalExamination
:FinalExamination rdf:type owl:Class ;
                  rdfs:subClassOf :Examination ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :leadsTo ;
                                    owl:allValuesFrom :Qualification
                                  ] ;
                  rdfs:comment "A formal test planned at the end of a course of study leading to a qualification. This test may result in the preparation and discussion of a (dissertation) thesis."@en ,
                               "Una prova formale prevista al termine di un percorso di insegnamenti che permette di ottenere una qualifica. Tale prova può avere come risultato la preparazione e la discussione di una tesi (di laurea)."@it ;
                  rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                  rdfs:label "Esame Finale"@it ,
                             "Final Examination"@en ;
                  owl:versionInfo "stabile"@it ,
                                  "stable"@en .


###  https://w3id.org/italia/onto/Learning/Grade
:Grade rdf:type owl:Class ;
       rdfs:subClassOf l0:Concept ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasGradingScale ;
                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :GradingScale
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :gradeValue ;
                         owl:cardinality "1"^^xsd:nonNegativeInteger
                       ] ;
       rdfs:comment "Il risultato (voto) conseguito dallo studente (riportato in rapporto al voto massimo  conseguibile)"@it ,
                    "The assigned mark for an achievement of a student"@en ,
                    "The class of the result (grade) achieved by the student (reported in relation to the maximum attainable grade)"@en ;
       rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
       rdfs:label "Grade"@en ,
                  "Voto"@it ;
       owl:versionInfo "stabile"@it ,
                       "stable"@en .


###  https://w3id.org/italia/onto/Learning/GradingScale
:GradingScale rdf:type owl:Class ;
              rdfs:subClassOf l0:Characteristic ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasMaximumGrade ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Grade
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasMinimumGrade ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Grade
                              ] ;
              rdfs:comment "La classe rappresenta la scala dei voti. Attraverso questa classe è possibile specificare un voto minimo e un voto massimo"@it ,
                           "The class represents the grade range. Through this class it is possible to specify a minimum grade and a maximum grade."@en ;
              rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
              rdfs:label "Grading Scale"@en ,
                         "Scala di Valutazione"@it ;
              owl:versionInfo "stabile"@it ,
                              "stable"@en ;
              <http://www.w3.org/ns/prov#wasDerivedFrom> <http://data.europa.eu/snb/model/elm/GradingScheme> .


###  https://w3id.org/italia/onto/Learning/Institute
:Institute rdf:type owl:Class ;
           rdfs:subClassOf :Organization ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasInstituteType ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :InstituteType
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :instituteName ;
                             owl:someValuesFrom rdf:PlainLiteral
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :instituteName ;
                             owl:allValuesFrom rdf:PlainLiteral
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :instituteCode ;
                             owl:cardinality "1"^^xsd:nonNegativeInteger
                           ] ;
           rdfs:comment """Any institution providing education courses capable of awarding degrees.

In the case of higher education, any institution providing higher education courses capable of awarding the qualifications referred to in Article 3 of Italian Ministerial Decree No 270 of 22 October 2004 and those referred to in Article 3 of Italian Presidential Decree No 212 of 8 July 2005."""@en ,
                        """Ogni Istituto che eroga corsi di istruzione atto a rilasciare titoli.

Nel caso di istruzione superiore, ogni istituto che eroga corsi di istruzione superiore atto a rilasciare i titoli di cui all'art. 3 del decreto ministeriale 22 ottobre 2004, n. 270 del  2004 nonche' quelli di cui all'art. 3 del  decreto  del  Presidente  della Repubblica 8 luglio 2005, n. 212."""@it ;
           rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
           rdfs:label "Institute"@en ,
                      "Istituto di (Alta) Formazione"@it ;
           owl:versionInfo "stabile"@it ,
                           "stable"@en ;
           <http://www.w3.org/ns/prov#wasDerivedFrom> <http://data.europa.eu/snb/model/elm/Organisation> .


###  https://w3id.org/italia/onto/Learning/InstituteType
:InstituteType rdf:type owl:Class ;
               rdfs:subClassOf l0:Characteristic ,
                               l0:Concept ;
               rdfs:comment "La tipologia di istituto usata per indicare se l'istituto è privato oppure pubblico. Di solito la distinzione è tra istituto statale (pubblico) e non statale (privato)."@it ,
                            "The type of institution used to indicate whether the institution is private (non state) or public (state)."@en ;
               rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
               rdfs:label "Institute Type"@en ,
                          "Tipo di Istituto"@it ;
               owl:versionInfo "stabile"@it ,
                               "stable"@en .


###  https://w3id.org/italia/onto/Learning/Learning
:Learning rdf:type owl:Class ;
          rdfs:subClassOf <https://w3id.org/italia/onto/TI/TimeIndexedEvent> ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :providedBy ;
                            owl:someValuesFrom :Institute
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :includesExamination ;
                            owl:allValuesFrom :Examination
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :providedBy ;
                            owl:allValuesFrom :Institute
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty l0:isMemberOf ;
                            owl:allValuesFrom :DegreeCourse
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :credit ;
                            owl:cardinality "1"^^xsd:nonNegativeInteger
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty <https://w3id.org/italia/onto/SM/URL> ;
                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:anyURI
                          ] ;
          rdfs:comment "Any event of training delivered by an organisation (institute) and attended by a person. It could include an examination. The event leads to the acquisition of knowledge, skills or responsibility and autonomy."@en ,
                       "Qualsiasi evento di formazione erogato da un'organizzazione (istituto) e frequentato da una persona. Può includere esami. L'evento porta all'acquisizione di conoscenze, competenze o responsabilità e autonomia."@it ;
          rdfs:isDefinedBy "https://w3id.org/italia/onto/Learning" ;
          rdfs:label "Insegnamento"@it ,
                     "Learning"@en ;
          <http://www.w3.org/ns/prov#wasInfluencedBy> <http://data.europa.eu/snb/model/elm/LearningActivity> .


###  https://w3id.org/italia/onto/Learning/LearningAchievementSpecification
:LearningAchievementSpecification rdf:type owl:Class ;
                                  rdfs:subClassOf l0:Collection ,
                                                  l0:Description ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty l0:hasMember ;
                                                    owl:someValuesFrom :Learning
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty l0:hasMember ;
                                                    owl:allValuesFrom :Learning
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty :entitlesTo ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onClass :Qualification
                                                  ] ;
                                  rdfs:comment "A description of what a student (person) learnt expressed as learning outcomes."@en ,
                                               "Una descrizione di ciò che uno studente (persona) ha appreso espressa come risultati degli insegnamenti."@it ;
                                  rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                                  rdfs:label "Learning Achievement Specification"@en ,
                                             "Specifica Risultati Insegnamenti"@it ;
                                  owl:versionInfo "provvisoria"@it ,
                                                  "unstable"@en ;
                                  <http://www.w3.org/ns/prov#wasInfluencedBy> <http://data.europa.eu/snb/model/elm/LearningAchievementSpecification> .


###  https://w3id.org/italia/onto/Learning/Organization
:Organization rdf:type owl:Class .


###  https://w3id.org/italia/onto/Learning/Profession
:Profession rdf:type owl:Class ;
            rdfs:subClassOf <https://w3id.org/italia/onto/RO/Role> ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty l0:name ;
                              owl:someValuesFrom rdfs:Literal
                            ] ;
            rdfs:comment "A profession is a field of work that has been successfully professionalized."@en ,
                         "Qualsiasi attività intellettuale o manuale esercitata in modo continuativo e a scopo di guadagno per cui è richiesta l'abilitazione."@it ;
            rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
            rdfs:label "Profession"@en ,
                       "Professione"@it ;
            owl:versionInfo "provvisoria"@it ,
                            "unstable"@en ;
            <http://www.w3.org/ns/prov#wasInfluencedBy> <http://data.europa.eu/snb/model/elm/LearningEntitlement> .


###  https://w3id.org/italia/onto/Learning/ProgrammeType
:ProgrammeType rdf:type owl:Class ;
               rdfs:subClassOf l0:Characteristic ,
                               l0:Concept ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty l0:name ;
                                 owl:someValuesFrom rdfs:Literal
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty l0:identifier ;
                                 owl:cardinality "1"^^xsd:nonNegativeInteger
                               ] ;
               rdfs:comment "La classe delle categorie di programmi di studio (es. laurea triennale, laurea magistrale, dottorato di ricerca, ecc.)"@it ,
                            "The class of programme categories (e.g. Bachelor's degree, Master's degree, PhD, etc.)."@en ;
               rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
               rdfs:label "Programme Type"@en ,
                          "Tipologia Corso di Studio"@it ;
               owl:versionInfo "stabile"@it ,
                               "stable"@en ;
               <http://www.w3.org/ns/prov#wasDerivedFrom> <http://www.w3.org/2004/02/skos/core#Concept> .


###  https://w3id.org/italia/onto/Learning/Qualification
:Qualification rdf:type owl:Class ;
               rdfs:subClassOf l0:Object ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :enablesProfession ;
                                 owl:allValuesFrom :Profession
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasLevel ;
                                 owl:allValuesFrom :QualificationLevel
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasGrade ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Grade
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :issuedBy ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Institute
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :achievedTitleName ;
                                 owl:someValuesFrom rdfs:Literal
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :achievedTitleName ;
                                 owl:allValuesFrom rdfs:Literal
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :qualificationDate ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange [ rdf:type rdfs:Datatype ;
                                                   owl:unionOf ( xsd:date
                                                                 xsd:dateTime
                                                               )
                                                 ]
                               ] ;
               rdfs:comment "A formal certification issued by a competent authority at the end of a learning path as proof of having achieved learning outcomes to given standards as established by the national education system."@en ,
                            "Una certificazione formale rilasciata da un'autorità competente al termine di un percorso di studi come prova del raggiungimento di risultati di apprendimento secondo determinati standard stabiliti dal sistema educativo nazionale."@it ;
               rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
               rdfs:label "Qualifica (Titolo di Studio)"@it ,
                          "Qualification"@en ;
               owl:versionInfo "stabile"@it ,
                               "stable"@en ;
               <http://www.w3.org/ns/prov#wasDerivedFrom> <http://data.europa.eu/m8g/Evidence> ,
                                                          <http://data.europa.eu/snb/model/elm/Qualification> .


###  https://w3id.org/italia/onto/Learning/QualificationLevel
:QualificationLevel rdf:type owl:Class ;
                    rdfs:subClassOf l0:Characteristic ;
                    rdfs:comment "Il livello della qualifica secondo framework europei (European Qualification Framework) e nazionali. Gli individui della classe infatti potrebbero essere i concetti di uno specifico vocabolario controllato sia con valenza europea (i.e., EQF Level), sia con valenza italiana (i.e., PCN EQF a cura dell'ANPAL)."@it ,
                                 "The qualification level according to European (European Qualification Framework) and national frameworks. The individuals of the class in fact could be the concepts of a specific controlled vocabulary both with European relevance (i.e., EQF Level) and with Italian relevance (i.e., PCN EQF by ANPAL)."@en ;
                    rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                    rdfs:label "Livello di Qualifica"@it ,
                               "Qualification Level"@en ;
                    owl:versionInfo "stabile"@it ,
                                    "stable"@en ;
                    <http://www.w3.org/ns/prov#wasDerivedFrom> <http://www.w3.org/2004/02/skos/core#Concept> .


###  https://w3id.org/italia/onto/Learning/QualificationTitle
:QualificationTitle rdf:type owl:Class ;
                    rdfs:subClassOf l0:Concept ;
                    rdfs:comment "It is the official designation used to identify and record a qualification in higher education. It represents the formal name of the achieved qualification and clearly describes the completed learning path within the university or AFAM systems."@en ,
                                 "È la denominazione ufficiale con cui una qualifica dell’istruzione superiore viene identificata e registrata. Rappresenta il nome formale del titolo conseguito, utile per descrivere in modo chiaro il percorso formativo completato all’interno dei sistemi universitari e AFAM."@it ;
                    rdfs:label "Qualification Title"@en ,
                               "Titolo di Qualifica"@it .


###  https://w3id.org/italia/onto/Learning/SpecialisationTitle
:SpecialisationTitle rdf:type owl:Class ;
                     rdfs:subClassOf :QualificationTitle ;
                     rdfs:comment "It is a title awarded at the end of specialised or advanced training programmes that provide in-depth or professional competences beyond basic academic education. It certifies a specialization in a specific field and may hold professional relevance. Specialisation titles in Italy currently belong to the healthcare area, the veterinary area, the cultural heritage area, the psychology area, and the legal professions area."@en ,
                                  "È un titolo rilasciato al termine di percorsi formativi specialistici o di perfezionamento che approfondiscono competenze avanzate oltre la formazione accademica di base. Riconosce una specializzazione in un ambito specifico e può avere valore professionale. I titoli di specializzazione, attualmente in Italia, appartengono all’area sanitaria, all’area veterinaria, all’area dei beni culturali, all’area psicologica ed all’area delle professioni legali."@it ;
                     rdfs:label "Specialisation Title"@en ,
                                "Titolo di Specializzazione"@it .


###  https://w3id.org/italia/onto/Learning/Student
:Student rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/italia/onto/RO/Role> ;
         rdfs:comment "Quando una persona si iscrive a un istituto di (alta) formazione, assume il ruolo di studente"@it ,
                      "When a person enrols in an institution of (higher) education, he/she assumes the role of student"@en ;
         rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
         rdfs:label "Student"@en ,
                    "Studente"@it ;
         owl:versionInfo "stabile"@it ,
                         "stable"@en .


###  https://w3id.org/italia/onto/Learning/TitleArea
:TitleArea rdf:type owl:Class ;
           rdfs:subClassOf l0:Concept ;
           rdfs:comment "Indica l’area disciplinare a cui appartiene un titolo della qualifica, secondo le classificazioni adottate nell’istruzione superiore. Serve a contestualizzare il contenuto formativo del titolo e a facilitarne la categorizzazione."@it ,
                        "It indicates the disciplinary area to which a qualification title belongs, according to classifications adopted in higher education. It helps contextualize the educational content of the title and facilitates its categorization."@en ;
           rdfs:label "Area del Titolo"@it ,
                      "Title Area"@en .


