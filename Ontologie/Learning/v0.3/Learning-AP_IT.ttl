###  https://w3id.org/italia/onto/Learning/academicYear
:academicYear rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf <https://w3id.org/italia/onto/TI/time> ;
              rdfs:domain :AcademicYear ;
              rdfs:range rdfs:Literal ;
              rdfs:comment """A time period in which students are trained in academia. Example: 2022/2023.

The property is used with the related class 'Academic Year' to indicate its value."""@en ,
                           """Un periodo temporale in cui si svolgono attività di formazione di studenti in ambito accademico. Esempio: 2022/2023.

La proprietà è usata con la relativa classe 'Anno Accademico' per indicare il suo valore (espresso come stringa alfanumerica)."""@it ;
              rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
              rdfs:label "academic year"@en ,
                         "anno accademico"@it ;
              owl:versionInfo "stabile"@it ,
                              "stable"@en .


###  https://w3id.org/italia/onto/Learning/achievedTitleName
:achievedTitleName rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf l0:name ;
                   rdfs:domain :QualificationTitle ;
                   rdfs:range rdf:PlainLiteral ;
                   rdfs:comment "La denominazione del titolo di studio conseguito."@it ,
                                "The name of the qualification obtained."@en ;
                   rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                   rdfs:label "Nome titolo di studio"@it ,
                              "achieved title name"@en ;
                   owl:versionInfo "stabile"@it ,
                                   "stable"@en .


###  https://w3id.org/italia/onto/Learning/courseYear
:courseYear rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf <https://w3id.org/italia/onto/TI/time> ;
            rdfs:domain :Enrolment ;
            rdfs:range rdfs:Literal ;
            rdfs:comment "Last year in which the student is enrolled in the course (e.g., 1st year, 2nd year)"@en ,
                         "Ultimo anno in cui lo studente risulta iscritto al corso (es:, 1° anno, 2°anno)"@it ;
            rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
            rdfs:label "anno corso"@it ,
                       "course year"@en ;
            owl:versionInfo "stabile"@it ,
                            "stable"@en .


###  https://w3id.org/italia/onto/Learning/credit
:credit rdf:type owl:DatatypeProperty ;
        rdfs:domain owl:Thing ;
        rdfs:range rdfs:Literal ;
        rdfs:comment "La proprietà rappresenta i crediti formativi universitari o accademici (CFU)"@it ,
                     "The property represents university or academic credits (CFU)"@en ;
        rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
        rdfs:label "credit"@en ,
                   "credito"@it ;
        owl:versionInfo "stabile"@it ,
                        "stable"@en .


###  https://w3id.org/italia/onto/Learning/gradeValue
:gradeValue rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf <https://w3id.org/italia/onto/MU/value> ;
            rdfs:domain :Grade ;
            rdfs:range rdfs:Literal ;
            rdfs:comment "Il valore numerico del risultato (voto) conseguito da uno studente. Esempio: 26 oppure anche 26/30."@it ,
                         "The numerical value of the result (grade) achieved by a student. Example: 26 or  26/30."@en ;
            rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
            rdfs:label "grade value"@en ,
                       "valore voto"@it ;
            owl:versionInfo "stabile"@it ,
                            "stable"@en .


###  https://w3id.org/italia/onto/Learning/instituteCode
:instituteCode rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf l0:identifier ;
               rdfs:domain :Institute ;
               rdfs:range rdfs:Literal ;
               rdfs:comment "Identificativo univoco dell'istituto di formazione."@it ,
                            "Unique identifier of the educational institution."@en ;
               rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
               rdfs:label "codice istituto"@it ,
                          "institute code"@en ;
               owl:versionInfo "stabile"@it ,
                               "stable"@en .


###  https://w3id.org/italia/onto/Learning/instituteName
:instituteName rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :legalName ;
               rdfs:domain :Institute ;
               rdfs:range rdf:PlainLiteral ;
               rdfs:comment "La denominazione (legale) dell'istituto"@it ,
                            "The legal name of the institute"@en ;
               rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
               rdfs:label "institute name"@en ,
                          "nome istituto"@it ;
               owl:versionInfo "stabile"@it ,
                               "stable"@en .


###  https://w3id.org/italia/onto/Learning/isVocational
:isVocational rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain l0:Entity ;
              rdfs:range xsd:boolean ;
              rdfs:comment "Property allowing one to specify whether an educational offer or course is vocational or not."@en ,
                           "Proprietà che consente di specificare se un'offerta formativa o un corso è professionalizzante o meno."@it ;
              rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
              rdfs:label "is vocational"@en ,
                         "è professionalizzante"@it ;
              owl:versionInfo "provvisoria"@en ,
                              "unstable"@en .


###  https://w3id.org/italia/onto/Learning/legalName
:legalName rdf:type owl:DatatypeProperty .


###  https://w3id.org/italia/onto/Learning/qualificationDate
:qualificationDate rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf <https://w3id.org/italia/onto/TI/date> ;
                   rdfs:domain :Qualification ;
                   rdfs:range [ rdf:type rdfs:Datatype ;
                                owl:unionOf ( xsd:date
                                              xsd:dateTime
                                            )
                              ] ;
                   rdfs:comment "La data di conseguimento del titolo di studio"@it ,
                                "The date of graduation"@en ;
                   rdfs:isDefinedBy <https://w3id.org/italia/onto/Learning> ;
                   rdfs:label "data titolo di studio"@it ,
                              "qualification date"@en ;
                   owl:versionInfo "stabile"@it ,
                                   "stable"@en .


