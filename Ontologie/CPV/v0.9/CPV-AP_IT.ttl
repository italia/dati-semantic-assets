                                              rdfs:subPropertyOf <https://w3id.org/italia/onto/CPV/hasParentalRelationshipWith> ;
                                              owl:inverseOf <https://w3id.org/italia/onto/CPV/isUncleOf> ;
                                              rdfs:domain <https://w3id.org/italia/onto/CPV/Person> ;
                                              rdfs:range <https://w3id.org/italia/onto/CPV/Person> .


###  https://w3id.org/italia/onto/CPV/isParentOf
<https://w3id.org/italia/onto/CPV/isParentOf> rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf <https://w3id.org/italia/onto/CPV/hasParentalRelationshipWith> ;
                                              rdfs:domain <https://w3id.org/italia/onto/CPV/Person> ;
                                              rdfs:range <https://w3id.org/italia/onto/CPV/Person> .


###  https://w3id.org/italia/onto/CPV/isRelatedToInstitute
<https://w3id.org/italia/onto/CPV/isRelatedToInstitute> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <https://w3id.org/italia/onto/CPV/EducationStatus> ;
                                                        rdfs:range <https://w3id.org/italia/onto/COV/Organization> ;
                                                        rdfs:label "is related to the institute"@en ,
                                                                   "è relativa all'istituto"@it .


###  https://w3id.org/italia/onto/CPV/isResidenceInTimeOf
<https://w3id.org/italia/onto/CPV/isResidenceInTimeOf> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <https://w3id.org/italia/onto/CPV/ResidenceInTime> ;
                                                       rdfs:range <https://w3id.org/italia/onto/CPV/Person> ;
                                                       rdfs:comment "Inverse property of \"has residence in time\" which links residence in time with the person"@en ,
                                                                    "Proprietà inversa di \"ha residenza nel tempo (ha stato residenza)\" che collega il concetto di residenza nel tempo con la persona."@it ;
                                                       rdfs:isDefinedBy <https://w3id.org/italia/onto/CPV> ;
                                                       rdfs:label "is residence in time of"@en ,
                                                                  "è stato residenza di (è residenza nel tempo di)"@it ;
                                                       owl:versionInfo "stabile"@it ,
                                                                       "stable"@en .


###  https://w3id.org/italia/onto/CPV/isUncleOf
<https://w3id.org/italia/onto/CPV/isUncleOf> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf <https://w3id.org/italia/onto/CPV/hasParentalRelationshipWith> ;
                                             rdfs:domain <https://w3id.org/italia/onto/CPV/Person> ;
                                             rdfs:range <https://w3id.org/italia/onto/CPV/Person> .


###  https://w3id.org/italia/onto/CPV/knows
<https://w3id.org/italia/onto/CPV/knows> rdf:type owl:ObjectProperty ;
                                         rdfs:subPropertyOf <https://w3id.org/italia/onto/CPV/hasRelationshipWith> ;
                                         rdf:type owl:SymmetricProperty ;
                                         rdfs:domain <https://w3id.org/italia/onto/CPV/Person> ;
                                         rdfs:range <https://w3id.org/italia/onto/CPV/Person> ;
                                         rdfs:comment "La relazione di conoscenza che intercorre tra due persone. Ex. 'Mario Rossi' conosce 'Paolo Neri'."@it ,
                                                      "The relationship of knowledge between two people. E.g. 'John White' knows 'Bob Black'."@en ;
                                         rdfs:isDefinedBy <https://w3id.org/italia/onto/CPV> ;
                                         rdfs:label "conosce"@it ,
                                                    "knows"@en ;
                                         owl:versionInfo "stabile"@it ,
                                                         "stable"@en .


###  https://w3id.org/italia/onto/CPV/residenceInLocation
<https://w3id.org/italia/onto/CPV/residenceInLocation> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <https://w3id.org/italia/onto/CPV/ResidenceInTime> ;
                                                       rdfs:range CLV:Feature ;
                                                       rdfs:comment "Property that links the residence in time (the n-ray relationship) to the location of the residence."@en ,
                                                                    "Proprietà che lega la residenza nel tempo (lo storico della residenza attraverso la definizione della relazione ennaria) al luogo della residenza."@it ;
                                                       rdfs:isDefinedBy <https://w3id.org/italia/onto/CPV> ;
                                                       rdfs:label "residence in location"@en ,
                                                                  "residenza in luogo"@it ;
                                                       owl:versionInfo "stabile"@it ,
                                                                       "stable"@en .


###  https://w3id.org/italia/onto/CPV/residentIn
<https://w3id.org/italia/onto/CPV/residentIn> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <https://w3id.org/italia/onto/CPV/Person> ;
                                              rdfs:range CLV:Feature ;
                                              rdfs:comment "Questa proprietà rappresenta la residenza espressa come relazione binaria tra una persona un luogo (e.g., roma, oppure via XXX, n. YY)."@it ,
                                                           "This property represents the residence expressed as binary relation between a person and a location (feature)."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/italia/onto/CPV> ;
                                              rdfs:label "resident in"@en ,
                                                         "residente in"@it ;
                                              owl:versionInfo "stabile"@it ,
                                                              "stable"@en .


