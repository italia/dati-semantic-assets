                                                       "Una persona naturale di sesso femminile"@it ;
                                          rdfs:isDefinedBy <https://w3id.org/italia/onto/CPV> ;
                                          rdfs:label "Female"@en ,
                                                     "Femmina"@it ;
                                          owl:versionInfo "stabile"@it ,
                                                          "stable"@en .


