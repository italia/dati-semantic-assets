<https://w3id.org/italia/onto/CPV> rdf:type owl:Ontology ;
                                    owl:versionIRI <https://w3id.org/italia/onto/CPV/0.9> ;
                                          owl:imports <https://w3id.org/italia/onto/CLV> ,
                                                      <https://w3id.org/italia/onto/TI> ,
                                                      <https://w3id.org/italia/onto/l0> ;
                                          dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/IRREG> ;
                                          dct:creator <https://w3id.org/italia/data/public-organization/ISTAT> ,
                                                      <https://w3id.org/italia/data/public-organization/agid> ;
                                          dct:description "Questa è l'ontologia del profilo applicativo italiano sulle persone. L'ontologia modella informazioni generali sulle persone fisiche come per esempio il nome, cognome, data di nascita, luogo di nascita, codice fiscale, residenza, cittadinanza e relazioni tra persone sia generiche di conoscenza sia di generiche relazioni di parentela ma non come registrate presso l'anagrafe."@it ,
                                                          "This is the ontology of the Italian application profile on persons. The ontology models general information on natural persons such as first name, surname, date of birth, place of birth, tax code, residence, citizenship and relations between persons both generic of knowledge and generic of kinship relations but not as registered with the civil registry."@en ;
                                          dct:identifier "https://w3id.org/italia/onto/CPV" ;
                                          dct:issued "2017-07-19"^^xsd:date ;
                                          dct:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                                                       <http://publications.europa.eu/resource/authority/language/ITA> ;
                                          dct:modified "2026-07-13"^^xsd:date ;
                                          dct:publisher <https://w3id.org/italia/data/public-organization/PCM-1RSIZZ> ;
                                          dct:rightsHolder <https://w3id.org/italia/data/public-organization/ISTAT> ;
                                          dct:title "CPV-AP_IT - Core Person Vocabulary Italian Application Profile - Person Ontology"@en ,
                                                    "CPV-AP_IT: Core Person Vocabulary - profilo applicativo italiano - Ontologia delle persone"@it ;
                                          rdfs:comment "Questa è l'ontologia del profilo applicativo italiano sulle persone. L'ontologia modella informazioni generali sulle persone fisiche come per esempio il nome, cognome, data di nascita, luogo di nascita, codice fiscale, residenza, cittadinanza e relazioni tra persone sia generiche di conoscenza sia di generiche relazioni di parentela ma non come registrate presso l'anagrafe."@it ,
                                                       "This is the ontology of the Italian application profile on persons. The ontology models general information on natural persons such as first name, surname, date of birth, place of birth, tax code, residence, citizenship and relations between persons both generic of knowledge and generic of kinship relations but not as registered with the civil registry."@en ;
                                          rdfs:isDefinedBy <https://w3id.org/italia/onto/CPV> ;
                                          rdfs:label "CPV-AP_IT - Core Person Vocabulary Italian Application Profile - Person Ontology"@en ,
                                                     "CPV-AP_IT: Core Person Vocabulary - profilo applicativo italiano - Ontologia delle persone"@it ;
                                          owl:versionInfo "Version 0.9 - updated on 13th of July 2026 - Added classes related to the person's educational/training pathways."@en ,
                                                          "Versione 0.9 - aggiornata il 13 Luglio 2026 - Aggiunte classi riferite ai percorsi formativi della persona."@it ;
                                          dcat:contactPoint <https://w3id.org/italia/data/contact-point/ISTAT-NDC> ;
                                          dcat:keyword "famiglia"@it ,
                                                       "persona"@it ,
                                                       "persone"@it ;
                                          dcat:theme <http://publications.europa.eu/resource/authority/data-theme/SOCI> ;
                                          prov:wasDerivedFrom <https://w3id.org/italia/onto/CPV/0.7> ;
                                          admsapit:acronym "CPV-AP_IT" ;
                                          admsapit:hasContributor <https://w3id.org/italia/data/organization/support-unit/cnr-Z6HZEH/stlab> ;
                                          admsapit:hasFormalityLevel admsapit:Formal ;
                                          admsapit:hasKeyClass <https://w3id.org/italia/onto/CPV/EducationLevel> ,
                                                               <https://w3id.org/italia/onto/CPV/Person> ,
                                                               <https://w3id.org/italia/onto/CPV/ResidenceInTime> ,
                                                               <https://w3id.org/italia/onto/CPV/Sex> ;
                                          admsapit:hasOntologyLanguage admsapit:OWL ;
                                          admsapit:hasSemanticAssetDistribution <https://w3id.org/italia/data/distribution/CPVAPIT-JSON-LD> ,
                                                                                <https://w3id.org/italia/data/distribution/CPVAPIT-RDF-TURTLE> ,
                                                                                <https://w3id.org/italia/data/distribution/CPVAPIT-RDF-XML> ;
                                          admsapit:hasTask admsapit:AnnotationTask ,
                                                           admsapit:QueryFormulationTask ;
                                          admsapit:last <https://w3id.org/italia/onto/CPV/0.9> ;
                                          admsapit:officialURI "https://w3id.org/italia/onto/CPV"^^xsd:anyURI ;
                                          admsapit:prefix "cpvapit" ;
                                          admsapit:prev <https://w3id.org/italia/onto/CPV/0.8> ;
                                          admsapit:semanticAssetInUse <https://w3id.org/italia/data/project/NDC> ,
                                                                      <https://w3id.org/italia/data/project/OntoPiA> ;
                                          admsapit:status "catalogued" ,
                                                          "published" ;
                                          admsapit:target "Imprese" ,
                                                          "Pubbliche Amministrazioni" ;
                                          admsapit:type admsapit:CoreOntology .

