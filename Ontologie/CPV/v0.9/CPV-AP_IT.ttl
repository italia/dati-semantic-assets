###  https://w3id.org/italia/onto/CLV/hasAddress
CLV:hasAddress rdf:type owl:ObjectProperty .


###  https://w3id.org/italia/onto/CPV/belongsToFamily
<https://w3id.org/italia/onto/CPV/belongsToFamily> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <https://w3id.org/italia/onto/CPV/Person> ;
                                                   rdfs:range <https://w3id.org/italia/onto/CPV/Family> ;
                                                   rdfs:comment "La relazione che lega una persona a una famiglia"@it ,
                                                                "The relationship that links a person to a family"@en ;
                                                   rdfs:isDefinedBy <https://w3id.org/italia/onto/CPV> ;
                                                   rdfs:label "appartiene a famiglia"@it ,
                                                              "belongs to family"@en ;
                                                   owl:versionInfo "stabile"@it ,
                                                                   "stable"@en .


###  https://w3id.org/italia/onto/CPV/hasBirthPlace
<https://w3id.org/italia/onto/CPV/hasBirthPlace> rdf:type owl:ObjectProperty ;
                                                 owl:inverseOf <https://w3id.org/italia/onto/CPV/isBirthPlaceOf> ;
                                                 rdfs:domain <https://w3id.org/italia/onto/CPV/Person> ;
                                                 rdfs:range l0:Location ;
                                                 rdfs:comment "La relazione che permette di asserire che una persona è nata in un certo luogo."@it ,
                                                              "The relation asserts that a person has a certain place of birth."@en ;
                                                 rdfs:isDefinedBy <https://w3id.org/italia/onto/CPV> ;
                                                 rdfs:label "birth place"@en ,
                                                            "luogo di nascita"@it ;
                                                 owl:versionInfo "stabile"@it ,
                                                                 "stable"@en .


###  https://w3id.org/italia/onto/CPV/hasCitizenship
<https://w3id.org/italia/onto/CPV/hasCitizenship> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <https://w3id.org/italia/onto/CPV/Person> ;
                                                  rdfs:range l0:Location ;
                                                  rdfs:comment "La relazione che lega una persona alla sua cittadinanza (ex. cittadinanza italiana)."@it ,
                                                               "The relation that links a person to its citizenship (e.g. Italian)"@en ;
                                                  rdfs:isDefinedBy <https://w3id.org/italia/onto/CPV> ;
                                                  rdfs:label "citizenship"@en ,
                                                             "ha cittadinanza"@it ;
                                                  owl:versionInfo "stabile"@it ,
                                                                  "stable"@en .


###  https://w3id.org/italia/onto/CPV/hasDeathPlace
